# Stage 1 — copy to .env (see plan/DEVELOPMENT_PLAN.md → Configuration)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# LM Studio server (OpenAI-compatible); used from step 2 on
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=google/gemma-4-12b   # chat/voice (DEC-32) -- check the current LM Studio catalog (`lms ps`/`lms ls`), names drift
EMBED_BASE_URL=http://localhost:1234/v1
EMBED_API_KEY=lm-studio
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
EMBED_DIM=768
