# Stage 1 — copy to .env (see plan/DEVELOPMENT_PLAN.md → Configuration)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# LM Studio server (OpenAI-compatible); used from step 2 on
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=google/gemma-4-12b   # chat/voice (DEC-32) -- check the current LM Studio catalog (`lms ps`/`lms ls`), names drift
CHAT_REASONING_EFFORT=none   # thinking off for /chat (V24, like voice)
EMBED_BASE_URL=http://localhost:1234/v1
EMBED_API_KEY=lm-studio
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
EMBED_DIM=768   # sent as `dimensions` with every embeddings request; the column is fixed at this size

# Gemini instead of LM Studio (step 6 comparison, plan/02-local-rag.md) -- env vars only:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=<paid Gemini key (R12)>
#   LLM_MODEL=gemini-2.5-flash       # current Flash model
#   EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   EMBED_API_KEY=<same key>
#   EMBED_MODEL=gemini-embedding-001  # then re-index: vectors differ from nomic's (R6)
#   CHAT_REASONING_EFFORT=none        # V20: Gemini 2.5 Flash accepts "none"; Pro can't turn thinking off
#   VOICE_REASONING_EFFORT=none       # check against the chosen model, set "low" if "none" is rejected

# Voice (step 4) -- Google Speech via ADC: `gcloud auth application-default login`
VOICE_LANGUAGE=en-US
STT_MODEL=latest_short
TTS_VOICE=en-US-Neural2-F
VOICE_REASONING_EFFORT=none   # thinking off for voice (DEC-29)
VAD_END_SILENCE_MS=700        # how long a silence must be before a turn counts as finished (V3)
VAD_BARGE_IN_AGGRESSIVENESS=3 # stricter speech_start while the bot is speaking (V9)
VAD_BARGE_IN_START_MS=300     # ...and a longer minimum speech length before it fires (V10)

# Dev only: reload the built web pages in the browser when web/dist changes, e.g. with
# `npm run build -- --watch` in web/ (never in cloud; `npm run dev` has its own hot reload)
DEV_RELOAD=true

# INFO: one log line per LLM call (model, prompt size, tokens, time to first token, total);
# DEBUG also logs the full prompt and response
LOG_LEVEL=INFO

# Twilio (step 4, modes A/B -- plan/03-voice-channel.md "Local development setup", DEC-43).
# Not needed for the voice app at /web/ (mode C). Console: Account SID + Auth Token on the
# dashboard; API key under Account → API keys; TwiML App under Voice → TwiML Apps.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=           # main number, E.164 (+1555…); assigned to a business in the voice app
# The ngrok URL (`ngrok http 8000`); must match the TwiML App's voice URL host exactly,
# or every webhook fails the signature check (403, logged)
PUBLIC_BASE_URL=
